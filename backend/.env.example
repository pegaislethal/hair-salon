NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/iris_salon
# Optional DNS servers for mongodb+srv connection lookups, comma-separated
MONGODB_DNS_SERVERS=
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRE=30d
BCRYPT_SALT_ROUNDS=12



# Gmail SMTP (keep these credentials server-side; never use NEXT_PUBLIC_ prefixes)
EMAIL_USER=yourgmail@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password
EMAIL_FROM=yourgmail@gmail.com
ADMIN_EMAIL=yourgmail@gmail.com
# SMS (Nepal-compatible)
SMS_PROVIDER=sparrowsms
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=IRIS

# Cloudinary (service images and applicant CV uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public frontend origin used to build verification and password-reset links.
FRONTEND_URL=http://localhost:3000
# Optional additional CORS origins, comma-separated (for example: https://salon.example.com)
CORS_ORIGIN=

# Super Admin Setup (for seed script)
SUPER_ADMIN_EMAIL=admin@irissalon.com
SUPER_ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_NAME=Iris Admin
