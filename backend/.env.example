NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/iris_salon
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRE=30d
BCRYPT_SALT_ROUNDS=12

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@irissalon.com
FROM_NAME=Iris Hair Cut and Salon
SALON_NOTIFICATION_EMAIL=admin@irissalon.com

# SMS (Nepal-compatible)
SMS_PROVIDER=sparrowsms
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=IRIS

# Cloudinary (for images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Super Admin Setup (for seed script)
SUPER_ADMIN_EMAIL=admin@irissalon.com
SUPER_ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_NAME=Iris Admin
